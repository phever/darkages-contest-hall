# ------------------------------------------------------------------------------
# ENVIRONMENT VARIABLES TEMPLATE
# ------------------------------------------------------------------------------
# Instructions:
# 1. Copy this file and rename the copy to exactly `.env`
# 2. Fill in the specific values for your environment.
# 3. DO NOT commit the `.env` file to version control.
# ------------------------------------------------------------------------------

# Master switch. "dev" relaxes the secure settings (DEBUG on, secure cookies off,
# file-based email). "production" enforces the hardened settings below.
ENVIRONMENT=dev

# --- Core (REQUIRED in production) --------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Comma-separated hostnames Django will serve (e.g. api.yourdomain.com)
DJANGO_ALLOWED_HOSTS=
# Set to 1 to also allow *.vercel.app hosts
ALLOW_VERCEL_HOSTS=0
# Override DEBUG explicitly if needed (defaults: on in dev, off in production)
# DEBUG=0

# --- Database -----------------------------------------------------------------
# Leave blank in dev to use local SQLite. REQUIRED in production / serverless
# (e.g. postgres://USER:PASS@HOST:5432/DBNAME). SQLite cannot persist on Vercel.
DATABASE_URL=

# --- Cross-origin / CSRF ------------------------------------------------------
# Comma-separated. Needed when the SPA is on a different origin than this API.
# With the recommended Vercel rewrite (same-origin), set these to your site URL.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
# Use 'None' only if cookies must be sent cross-site (also forces Secure).
AUTH_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# --- JWT / throttling (optional overrides) ------------------------------------
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
THROTTLE_LOGIN=10/min
THROTTLE_SUBMIT=20/hour

# --- HSTS (production) --------------------------------------------------------
SECURE_HSTS_SECONDS=31536000

# --- Email --------------------------------------------------------------------
# Required in production (Mailgun via Anymail). Ignored in dev.
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_SENDER_DOMAIN=your_mailgun_domain.com
