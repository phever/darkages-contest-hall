# ------------------------------------------------------------------------------
# ENVIRONMENT VARIABLES TEMPLATE
# ------------------------------------------------------------------------------
# Instructions:
# 1. Copy this file and rename the copy to exactly `.env`
# 2. Fill in the specific values for your environment.
# 3. DO NOT commit the `.env` file to version control.
# ------------------------------------------------------------------------------

# Define the environment. 
# Set to "dev" to use Django's file-based email backend (emails are saved to the /sent_emails folder).
# Set to "production" to use Mailgun to actually send out emails.
ENVIRONMENT=dev

# Mailgun API Key (Required for production email sending)
MAILGUN_API_KEY=your_mailgun_api_key_here

# Mailgun Sender Domain (Required for production email sending, e.g., mg.yourdomain.com)
MAILGUN_SENDER_DOMAIN=your_mailgun_domain.com
