{
  "version": 2,
  "builds": [
    {
      "src": "config/wsgi.py",
      "use": "@vercel/python",
      "config": { "includeFiles": "staticfiles/**" }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "config/wsgi.py" }
  ],
  "crons": [
    { "path": "/api/cron/send-reminders/", "schedule": "0 14 * * *" }
  ]
}
